rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // DMIT fingerprint images: public upload to dmit/ folder; admins can read
    match /dmit/{submissionId}/{fileName} {
      allow write: if request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow read: if true;
    }

    // Default: deny all
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
